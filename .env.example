# ──────────────────────────────────────────────────────────────────────────────
# Yanthara Bulk Email — configuration. Copy to .env and fill in. NEVER commit .env.
# Every value here is this application's own: nothing is shared with any other app.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4300
# The address people open in the browser. Also used to build the Google sign-in callback.
APP_BASE_URL=http://localhost:4300
# The name shown in the app's header.
COMPANY_NAME=Yanthara

# ── Storage (this app's own) ─────────────────────────────────────────────────
# SQLite database file (relative paths are relative to the prisma/ folder).
DATABASE_URL=file:../data/yanthara.db
# Uploaded Excel files, attachments, company ZIPs and the test-mode outbox.
DATA_DIR=./data

# ── Secrets (generate fresh values; never reuse another app's) ──────────────
# At least 32 random characters. Signs sign-in sessions.
SESSION_SECRET=
SESSION_HOURS=12
# 32 random bytes, base64 (npm run key:generate). Encrypts Gmail refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=

# ── Gmail sender accounts (Google Cloud OAuth client of type "Web application") ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty to use APP_BASE_URL + /api/oauth/google/callback (register exactly that URL in Google Cloud).
GOOGLE_OAUTH_REDIRECT_URL=
# Optional: also ask for read access to the mailbox, so an email whose result is unknown
# (for example a lost connection) can be looked up in Sent automatically. Off by default.
GMAIL_READONLY_CHECK=false

# ── Sending ──────────────────────────────────────────────────────────────────
# test = nothing is sent: every email is written to DATA_DIR/outbox as an .eml file.
# live = emails are sent through the connected Gmail accounts. Switch only when approved.
SEND_MODE=test
# Time zone of the date and time chosen on the screen.
APP_TIMEZONE=Asia/Kolkata
# Smallest gap allowed between two emails of a campaign (minutes).
MIN_INTERVAL_MINUTES=1
# Emails one Gmail account may send in any 24 hours (Google Workspace allows 2,000; free Gmail 500).
DEFAULT_DAILY_LIMIT=400
# How often the sender looks for emails that are due (seconds).
DISPATCH_TICK_SECONDS=20
# 0 = off. Otherwise nobody receives a second email from any campaign within this many days.
REPEAT_COOLDOWN_DAYS=0
# Companies whose Status column contains one of these words (comma-separated) are skipped.
EXCEL_SKIP_STATUS_WORDS=outreach
# Adds a List-Unsubscribe header pointing to the sender's own mailbox (no public address needed).
LIST_UNSUBSCRIBE_MAILTO=true

# ── Open tracking: OFF until a public HTTPS domain is configured (see README) ──
TRACKING_ENABLED=false
TRACKING_BASE_URL=

# ── Google endpoints (leave as they are; tests point these at a fake server) ──
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
GMAIL_API_BASE=https://gmail.googleapis.com
